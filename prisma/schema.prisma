// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  sessionPlayers     SessionPlayer[]
  team1Player1Of     Match[]            @relation("Team1Player1")
  team1Player2Of     Match[]            @relation("Team1Player2")
  team2Player1Of     Match[]            @relation("Team2Player1")
  team2Player2Of     Match[]            @relation("Team2Player2")
  fixedPartner1Of    FixedPartnership[] @relation("FixedPartner1")
  fixedPartner2Of    FixedPartnership[] @relation("FixedPartner2")
}

enum SessionType {
  AMERICANO
  MEXICANO
}

enum ScoringMode {
  POINTS
  SET
}

model Community {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  loginCodes LoginCode[]
  sessions   Session[]
}

model Session {
  id             String      @id @default(cuid())
  name           String
  date           DateTime
  sessionType    SessionType @default(AMERICANO)
  fixedPartners  Boolean     @default(false)
  courts         Int
  dynamicCourts  Boolean     @default(false)
  venueName      String?
  courtNames     String[]    @default([])
  pointsPerMatch Int         @default(21)
  pointsPerServe Int         @default(5)
  scoringMode    ScoringMode @default(POINTS)
  gamesPerSet    Int         @default(4)
  goldenPoint    Boolean     @default(true)
  createdAt      DateTime    @default(now())
  communityId    String?

  community         Community?         @relation(fields: [communityId], references: [id])
  players           SessionPlayer[]
  rounds            Round[]
  fixedPartnerships FixedPartnership[]
}

model FixedPartnership {
  id        String @id @default(cuid())
  sessionId String
  player1Id String
  player2Id String

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player1 Player  @relation("FixedPartner1", fields: [player1Id], references: [id])
  player2 Player  @relation("FixedPartner2", fields: [player2Id], references: [id])
}

model SessionPlayer {
  id        String  @id @default(cuid())
  sessionId String
  playerId  String
  active    Boolean @default(true)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player  @relation(fields: [playerId], references: [id])

  @@unique([sessionId, playerId])
}

model Round {
  id          String @id @default(cuid())
  sessionId   String
  roundNumber Int

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  matches Match[]

  @@unique([sessionId, roundNumber])
}

model Match {
  id          String @id @default(cuid())
  roundId     String
  courtNumber Int

  team1Player1Id String
  team1Player2Id String
  team2Player1Id String
  team2Player2Id String

  team1Score Int @default(0)
  team2Score Int @default(0)

  // SET scoring mode only (session.scoringMode === SET): games won so far,
  // and the raw point count within the game currently being played. A
  // tiebreak isn't stored separately — it's detected on the fly whenever
  // both team1Games/team2Games equal session.gamesPerSet - 1.
  team1Games      Int @default(0)
  team2Games      Int @default(0)
  team1GamePoints Int @default(0)
  team2GamePoints Int @default(0)

  completed Boolean @default(false)

  // Serve tracking: which team serves now, and which of that team's
  // two players serves next time it's that team's turn (see servingPlayerId()).
  servingTeam     Int @default(1)
  team1ServerSlot Int @default(1)
  team2ServerSlot Int @default(1)

  round        Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  team1Player1 Player @relation("Team1Player1", fields: [team1Player1Id], references: [id])
  team1Player2 Player @relation("Team1Player2", fields: [team1Player2Id], references: [id])
  team2Player1 Player @relation("Team2Player1", fields: [team2Player1Id], references: [id])
  team2Player2 Player @relation("Team2Player2", fields: [team2Player2Id], references: [id])

  @@unique([roundId, courtNumber])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

model LoginCode {
  id          String   @id @default(cuid())
  label       String
  codeHash    String
  createdAt   DateTime @default(now())
  communityId String?

  community Community? @relation(fields: [communityId], references: [id])
}
